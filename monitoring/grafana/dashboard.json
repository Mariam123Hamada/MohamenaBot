{
  "id": null,
  "uid": "mohamenabot",
  "title": "MohamenaBot — Retrieval Monitoring",
  "tags": ["mohamenabot", "retrieval"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "title": "Prediction p95 latency (seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(mohamenabot_prediction_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 2,
      "title": "Prediction requests per second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(mohamenabot_prediction_requests_total[5m]))",
          "legendFormat": "requests/s"
        }
      ]
    },
    {
      "id": 3,
      "title": "Embedding input drift (corpus p95 units)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "mohamenabot_embedding_input_drift",
          "legendFormat": "normalized centroid distance"
        }
      ]
    },
    {
      "id": 4,
      "title": "Retrieved provisions per request",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(mohamenabot_retrieved_results_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    }
  ]
}
